{
  "expo": {
    "name": "cronogramafpr",
    "slug": "cronogramafpr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fpr.png",
    "scheme": "cronogramafpr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/fpr.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.vsantosdefato.cronogramafpr"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fpr.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/fpr.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "36b1a890-c420-4dea-9b94-fe70fa3eacfe"
      }
    }
  }
}
